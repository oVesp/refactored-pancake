local byId: { [string]: Types.SkillDef } = {}
for _, skill in list do
	assert(not byId[skill.id], `Duplicate skill id {skill.id}`)
	byId[skill.id] = table.freeze(skill)
end

return table.freeze({
	ById = table.freeze(byId),
	--[=[
		Unarmed basic attacks (the `fists` weapon), bound to light and heavy attack. `Light` is the
		entry of the light chain (`chainNext`, Shared/Chain). Other weapons name their own in
		Content/Weapons.
	]=]
	Basic = table.freeze({ Light = "strike", Heavy = "heavy_strike" }),
})
