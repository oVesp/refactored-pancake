--!strict

export type AudioAsset = {
	id: string,
	volume: number,
	looped: boolean?,
}

export type TextureAsset = {
	id: string?,
	fallback: string,
}

export type MeshAsset = {
	id: string,
	texture: string?,
	-- SurfaceAppearance PBR maps; `texture` is the colour map.
	normal: string?,
	metalness: string?,
	roughness: string?,
}

