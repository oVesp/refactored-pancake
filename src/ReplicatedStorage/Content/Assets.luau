--!strict

export type AudioAsset = {
	id: string,
	volume: number,
	looped: boolean?,
}

export type TextureAsset = {
	id: string?,
	fallback: string,
}

export type AnimationAsset = {
	id: string?,
	keyframes: string,
}

export type MeshAsset = {
	id: string,
	texture: string,
}

