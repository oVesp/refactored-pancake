--!strict

-- Serialises generator output into Luau ModuleScripts that the Studio applier reads.
local Encode = {}

local ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

function Encode.base64(data: buffer): string
	local len = buffer.len(data)
	local out = table.create(math.ceil(len / 3))
	local chars = table.create(64)
	for k = 1, 64 do
		chars[k - 1] = string.sub(ALPHABET, k, k)
	end
	for k = 0, len - 1, 3 do
		local b0 = buffer.readu8(data, k)
		local b1 = if k + 1 < len then buffer.readu8(data, k + 1) else 0
		local b2 = if k + 2 < len then buffer.readu8(data, k + 2) else 0
		local v = b0 * 65536 + b1 * 256 + b2
		local c2 = if k + 1 < len then chars[bit32.band(bit32.rshift(v, 6), 63)] else "="
		local c3 = if k + 2 < len then chars[bit32.band(v, 63)] else "="
		table.insert(out, chars[bit32.rshift(v, 18)] .. chars[bit32.band(bit32.rshift(v, 12), 63)] .. c2 .. c3)
	end
	return table.concat(out)
end

--[=[ Heights are stored as unsigned 16-bit sixteenths of a stud above -128. ]=]
function Encode.height(h: number): number
	return math.clamp(math.floor((h + 128) * 16 + 0.5), 1, 65535)
end

function Encode.decodeHeight(v: number): number
	return v / 16 - 128
end

local HEADER = "--!strict\n-- Generated by tools/terrain/build.luau. Do not edit; rerun the generator.\n"

function Encode.stringModule(value: string): string
	return HEADER .. 'return "' .. value .. '"\n'
end

function Encode.linesModule(lines: { string }): string
	return HEADER .. "return [[\n" .. table.concat(lines, "\n") .. "\n]]\n"
end

--[=[ Renders a plain table as stylua-formatted Luau source (keys sorted, tabs). ]=]
function Encode.luau(value: any, indent: string?): string
	local pad = indent or ""
	local t = typeof(value)
	if t == "number" then
		if value == math.floor(value) then
			return string.format("%d", value)
		end
		return (string.format("%.3f", value):gsub("0+$", ""):gsub("%.$", ".0"))
	elseif t == "string" then
		return string.format("%q", value)
	elseif t == "boolean" then
		return tostring(value)
	end
	local inner = pad .. "\t"
	local parts = {}
	if #value > 0 then
		for _, v in value do
			table.insert(parts, inner .. Encode.luau(v, inner) .. ",")
		end
	else
		local keys = {}
		for k in value do
			table.insert(keys, k)
		end
		table.sort(keys)
		for _, k in keys do
			local key = if string.match(k, "^[%a_][%w_]*$") then k else `[{string.format("%q", k)}]`
			table.insert(parts, inner .. key .. " = " .. Encode.luau(value[k], inner) .. ",")
		end
	end
	if #parts == 0 then
		return "{}"
	end
	return "{\n" .. table.concat(parts, "\n") .. "\n" .. pad .. "}"
end

function Encode.tableModule(value: any): string
	return HEADER .. "return " .. Encode.luau(value) .. "\n"
end

return Encode
